{
  "name": "split",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Split: a gym planner and log that runs as a Flinsh app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:harness": "node scripts/harness.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.9",
    "jsdom": "^29.1.1",
    "playwright": "1.57",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  }
}
